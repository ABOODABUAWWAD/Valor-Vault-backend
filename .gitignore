# ==========================================
# uv & Virtual Environments
# ==========================================
# uv's default virtual environment directory
.venv/
# If you explicitly name your venv something else
venv/
ENV/
env/

# uv lockfile 
# NOTE: Generally, you SHOULD commit uv.lock to version control for applications (like FastAPI).
# Uncomment the line below ONLY if you are building a library, not a deployed app.
# uv.lock

# ==========================================
# FastAPI / Application Specific
# ==========================================
# Environment variables containing sensitive secrets (DB credentials, API keys)
.env
.env.*
!.env.example

# Database files (if using local SQLite for development)
*.db
*.sqlite3

# Log files
*.log
logs/

