# Application
APP_ENV=development
PORT=8000

# Postgres (Docker-only). asyncpg driver URL.
DATABASE_URL=postgresql+asyncpg://valor:valor@localhost:5432/valor

# Redis (Docker-only).
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: openssl rand -hex 32  (must be 32+ chars)
JWT_SECRET=change-me-in-prod-0000000000000000000000000000000000
JWT_TTL_SECONDS=86400
BCRYPT_ROUNDS=12

# Login throttle
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_SECONDS=900

# Product read-cache TTL (seconds)
PRODUCT_CACHE_TTL_SECONDS=300

# CORS allowed origins (comma-separated, e.g. http://localhost:3000,http://localhost:3001)
CORS_ORIGINS=http://localhost:3000
